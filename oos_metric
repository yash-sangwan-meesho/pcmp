create table scrap.oos_all_events_v3 as
WITH  product_universe AS (
    SELECT DISTINCT
        o.supplier_id,
        o.product_id,
        o.event_id,
        e.event_name,
        e.event_start_date,
        e.event_start_time,
        e.event_end_date,
        e.event_end_time
    FROM gold.offers_master_updated o
    JOIN ((
    SELECT 
        event_name,
        event_id,
        event_start_date,
        event_start_time,
        event_end_date,
        event_end_time
    FROM mercury.events_master_updated
)

UNION

(
    SELECT 
        event_name,
        event_id,
        event_start_date,
        event_start_time,
        event_end_date,
        event_end_time
    FROM mercury.events_master
)

UNION

(
    SELECT
        'fsms' AS event_name,
        265 as event_id,
        DATE('2025-04-06') AS event_start_date,
        TIMESTAMP('2025-04-06 00:00:00') AS event_start_time,
        DATE('2025-04-06') AS event_end_date,
        TIMESTAMP('2025-04-06 23:59:00') AS event_end_time
)

UNION

(
    SELECT
        'Maha Indian Saving Sale' AS event_name,
        258 as event_id,
        DATE('2025-03-01') AS event_start_date,
        TIMESTAMP('2025-03-01 00:00:00') AS event_start_time,
        DATE('2025-03-02') AS event_end_date,
        TIMESTAMP('2025-03-02 23:59:00') AS event_end_time
)
) e
        ON CAST(o.event_id AS STRING) = CAST(e.event_id AS STRING)
    WHERE 
        (
            o.status = 'ACTIVE' 
            OR 
            (
                o.status != 'ACTIVE' AND
                from_utc_timestamp(from_unixtime(o.updated_at / 1000), 'Asia/Kolkata')
                    BETWEEN cast(from_utc_timestamp(e.event_start_time, 'Asia/Kolkata') AS timestamp)
                    AND cast(from_utc_timestamp(e.event_end_time, 'Asia/Kolkata') AS timestamp)
            )
        )
       and o.event_id in (271,281,258,265,249,239) and e.event_id in (271,281,258,265,249,239)
),
oos_events AS (
    SELECT
        i.supplier_id,
        i.product_id,
        pu.event_id,
        i.inventory_updated_timestamp AS oos_timestamp,
        pu.event_start_time,
        pu.event_end_time,
        supplier_oos,
        LAG(i.live_inventory) OVER (
            PARTITION BY i.supplier_id, i.product_id,pu.event_id
            ORDER BY i.inventory_updated_timestamp
        ) AS inventory_before_oos
   
    FROM silver.inventory__inventory_product_inventory_log_v2 i
    JOIN product_universe pu
      ON i.supplier_id = pu.supplier_id
      AND i.product_id = pu.product_id
    WHERE 
    from_utc_timestamp(i.inventory_updated_timestamp, 'Asia/Kolkata')
    BETWEEN cast(from_utc_timestamp(pu.event_start_time - INTERVAL 30 DAYS, 'Asia/Kolkata') AS timestamp)
    AND cast(from_utc_timestamp(pu.event_end_time, 'Asia/Kolkata') AS timestamp)
    AND i.inventory_updated_timestamp >= pu.event_start_time - INTERVAL 60 DAYS
    and year='2025'
),
oos_info_0 AS (
    SELECT 
        oe.supplier_id, 
        oe.product_id, 
        oe.event_id, 
        oe.oos_timestamp,
        oe.inventory_before_oos
    FROM (
        SELECT *, 
            ROW_NUMBER() OVER (PARTITION BY supplier_id, product_id, event_id ORDER BY oos_timestamp ASC) AS rn
        FROM oos_events
        WHERE supplier_oos = 1 AND 
              from_utc_timestamp(oos_timestamp, 'Asia/Kolkata') BETWEEN cast(from_utc_timestamp(event_start_time, 'Asia/Kolkata') AS timestamp)
              AND cast(from_utc_timestamp(event_end_time, 'Asia/Kolkata') AS timestamp)
    ) oe

    WHERE oe.rn = 1
),
oos_info_1 AS (
    SELECT 
        oe.supplier_id, 
