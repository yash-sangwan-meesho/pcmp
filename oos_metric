            ROW_NUMBER() OVER (PARTITION BY supplier_id, product_id, event_id ORDER BY oos_timestamp ASC) AS rn
        FROM oos_events
        WHERE supplier_oos = 1 AND 
              from_utc_timestamp(oos_timestamp, 'Asia/Kolkata') BETWEEN cast(from_utc_timestamp(event_start_time- INTERVAL 1 DAYS, 'Asia/Kolkata') AS timestamp)
              AND cast(from_utc_timestamp(event_end_time- INTERVAL 1 DAYS, 'Asia/Kolkata') AS timestamp)
    ) oe

    WHERE oe.rn = 1
),
